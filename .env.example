# 복사해서 사용: cp .env.example .env
# .env는 커밋하지 않는다 (.gitignore)

# DB
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
DB_PORT=5432

# 임베딩 서버 (TEI)
# Mac(ARM): cpu-arm64-1.9.4 / 회사 Linux(x86): cpu-1.9.4
TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-arm64-1.9.4
EMBED_PORT=8080

# bge-m3 모델 버전 고정 (Hugging Face 커밋, 2026-10-27 확인)
EMBED_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181

# 한 번에 처리할 최대 토큰 수 (TEI 기본 16384). 메모리와 속도에 영향
# 2048: 메모리 약 3.9GB, 대량 처리 15~25% 느림 (16384는 약 11.8GB). notes/01 참고
# 조각 하나도 이 길이를 넘으면 조용히 잘린다
EMBED_MAX_BATCH_TOKENS=2048

# 리랭커 (TEI, 같은 이미지). bge-reranker-v2-m3 버전 고정 (Hugging Face 커밋, 2026-11-10 확인)
RERANK_PORT=8081
RERANK_MODEL_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
# 질문+조각 한 쌍이 이 길이를 넘으면 뒤를 자른다 (--auto-truncate)
RERANK_MAX_BATCH_TOKENS=4096

# 엔진 API (engine/app/api.py). 컨테이너 포트를 Mac의 이 포트로 연다 (기본 8000)
ENGINE_PORT=8000
# 웹에서 가져올 수 있는 문서 폴더. 여러 개면 콜론(:)으로 구분. 비우면 아무것도 가져오지 못한다
INGEST_ROOTS=/path/to/docs-repo
# 외부 API(OpenAI 임베딩·답변)로 보내도 되는 문서 폴더. 이 안의 문서는 가져올 때 "외부 전송 허용"으로 시작한다.
# 여기에 없는 폴더(회사 문서 등)는 "불가"로 시작한다. 여러 개면 콜론(:)으로 구분. Knowledge 화면에서 문서마다 바꿀 수 있다
EXTERNAL_OK_ROOTS=/path/to/docs-repo

# 작업 대기열 (Redis). 엔진(Mac)이 작업을 넣을 주소. worker 컨테이너는 compose.yaml에서 따로 정한다
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0

# 외부 임베딩 (OpenAI). 비워 두면 화면에서 OpenAI 선택지가 "키 없음"으로 잠긴다. 키는 커밋하지 않는다
OPENAI_API_KEY=
# OpenAI 호환 주소를 쓸 때만 바꾼다 (기본 https://api.openai.com/v1)
# OPENAI_BASE_URL=

# 사용 기록의 하루·한 달 경계 시간대
USAGE_TZ=Asia/Seoul

# 추적 (OpenTelemetry → Tempo → Grafana). 이미지 버전은 compose.yaml 기본값으로 고정돼 있다
TEMPO_PORT=3200
GRAFANA_PORT=3000
# 웹 화면의 "추적 보기" 링크가 여는 Grafana 주소 (브라우저 기준)
GRAFANA_PUBLIC_URL=http://localhost:3000
# 회사 서버에서는 false로 두고 관리자 비밀번호를 바꾼다
GRAFANA_ANONYMOUS=true
GRAFANA_ADMIN_PASSWORD=change-me

