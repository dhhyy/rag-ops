# 복사해서 사용: cp .env.example .env
# .env는 커밋하지 않는다 (.gitignore)

# DB
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
DB_PORT=5432

# 임베딩 서버 (TEI)
# Mac(ARM): cpu-arm64-1.9.4 / 회사 Linux(x86): cpu-1.9.4
TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-arm64-1.9.4
EMBED_PORT=8080

# bge-m3 모델 버전 고정 (Hugging Face 커밋, 2026-10-27 확인)
EMBED_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181

# 한 번에 처리할 최대 토큰 수 (TEI 기본 16384). 메모리와 속도에 영향
# 2048: 메모리 약 3.9GB, 대량 처리 15~25% 느림 (16384는 약 11.8GB). notes/01 참고
# 조각 하나도 이 길이를 넘으면 조용히 잘린다
EMBED_MAX_BATCH_TOKENS=2048

# 엔진 API (engine/app/api.py). 컨테이너 포트를 Mac의 이 포트로 연다 (기본 8000)
ENGINE_PORT=8000
# 웹에서 가져올 수 있는 문서 폴더. 여러 개면 콜론(:)으로 구분. 비우면 아무것도 가져오지 못한다
INGEST_ROOTS=/path/to/docs-repo

# 작업 대기열 (Redis). 엔진(Mac)이 작업을 넣을 주소. worker 컨테이너는 compose.yaml에서 따로 정한다
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
